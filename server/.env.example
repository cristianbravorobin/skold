# Copia este archivo a server/.env y completa para PRODUCCIÓN.
# Sin estas variables, el backend corre en modo INTEGRACIÓN (sandbox) de Transbank.

# Cambia a "produccion" para usar credenciales reales:
TBK_ENV=integracion

# Credenciales de tu comercio Webpay Plus (las entrega Transbank):
TBK_COMMERCE_CODE=
TBK_API_KEY=

# URLs (ajusta a tu dominio en producción):
FRONTEND_URL=http://localhost:4200
SELF_URL=http://localhost:3000
PORT=3000
